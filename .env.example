# Hosted deployment defaults to Google Gemini (free tier, no card required):
# https://aistudio.google.com/apikey
ID_ASSIST_PROVIDER=google
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_MODEL=gemini-2.5-flash

# Database (Neon serverless Postgres) — create a project at
# https://neon.tech, then copy the pooled connection string from its
# dashboard (Connection Details > Connection string):
DATABASE_URL=

# Auth.js / NextAuth — random secret used to sign session cookies/JWTs.
# Generate one with: npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET=

# Optional local dev provider — run against Ollama on this machine instead:
# ID_ASSIST_PROVIDER=ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_MODEL=id-assist-tutor
# (then: npm run ollama:setup)

# Optional other cloud providers:
# ID_ASSIST_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.6
# ID_ASSIST_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5
# ID_ASSIST_PROVIDER=gateway
# AI_GATEWAY_API_KEY=
# ID_ASSIST_MODEL=anthropic/claude-sonnet-5

# Google Drive OAuth — required later for medium/large file uploads (images,
# video). Large media is never stored on our own infra; users connect their
# own Drive and we store only the file reference. Not implemented yet.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback

# Stripe billing (Phase B) — create a Stripe account at https://stripe.com,
# create one recurring Price for the ID Assist plan, and set up a webhook
# endpoint pointing at <your deployment>/api/stripe/webhook subscribed to
# checkout.session.completed, customer.subscription.created,
# customer.subscription.updated, and customer.subscription.deleted.
# Leaving these unset just means Settings → Billing shows "not set up yet" —
# nothing else breaks.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Cost-protection guardrail: max AI generations (refine/import/tutor reply/
# brief-coach) a single workspace can run per calendar month. Optional —
# defaults to 150 if unset.
USAGE_MONTHLY_GENERATION_LIMIT=150
